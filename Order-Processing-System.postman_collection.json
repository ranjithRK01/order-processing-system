{
  "info": {
    "_postman_id": "c6f38e7d-0d3d-4495-8e95-01ddad4ef1e6",
    "name": "Order Processing System",
    "description": "End-to-end local validation collection. Run requests in folder order. Create Order saves orderId and an idempotency key; audit and invoice processing can take up to 20 seconds because the real SQS worker long-polls.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://127.0.0.1:8000"},
    {"key": "orderId", "value": ""},
    {"key": "pendingOrderId", "value": ""},
    {"key": "idempotencyKey", "value": ""},
    {"key": "pendingIdempotencyKey", "value": ""}
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health Check",
          "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/health"},
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Service is healthy', function () {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().status).to.eql('healthy');",
            "});"
          ]}}]
        },
        {
          "name": "Readiness Check",
          "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/health/ready"},
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('MongoDB and AWS dependencies are ready', function () {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().status).to.eql('ready');",
            "});"
          ]}}]
        }
      ]
    },
    {
      "name": "Orders - happy path",
      "item": [
        {
          "name": "Create Order",
          "event": [
            {"listen": "prerequest", "script": {"type": "text/javascript", "exec": [
              "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
            ]}},
            {"listen": "test", "script": {"type": "text/javascript", "exec": [
              "pm.test('Order is created as PENDING', function () {",
              "  pm.response.to.have.status(201);",
              "  const order = pm.response.json();",
              "  pm.expect(order.status).to.eql('PENDING');",
              "  pm.expect(Number(order.total_amount)).to.eql(128.99);",
              "  pm.collectionVariables.set('orderId', order.id);",
              "  pm.expect(pm.response.headers.get('X-Request-ID')).to.exist;",
              "});"
            ]}}
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Idempotency-Key", "value": "{{idempotencyKey}}"},
              {"key": "X-Request-ID", "value": "postman-create-order"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"customer_id\": \"customer-postman-001\",\n  \"items\": [\n    {\n      \"product_id\": \"SKU-HEADPHONES-001\",\n      \"name\": \"Wireless Headphones\",\n      \"quantity\": 1,\n      \"unit_price\": 99.99\n    },\n    {\n      \"product_id\": \"SKU-CASE-001\",\n      \"name\": \"Protective Case\",\n      \"quantity\": 2,\n      \"unit_price\": 14.50\n    }\n  ]\n}"},
            "url": "{{baseUrl}}/orders"
          }
        },
        {
          "name": "Replay Same Create Request - Idempotency",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Idempotency-Key", "value": "{{idempotencyKey}}"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"customer_id\": \"customer-postman-001\",\n  \"items\": [\n    {\n      \"product_id\": \"SKU-HEADPHONES-001\",\n      \"name\": \"Wireless Headphones\",\n      \"quantity\": 1,\n      \"unit_price\": 99.99\n    },\n    {\n      \"product_id\": \"SKU-CASE-001\",\n      \"name\": \"Protective Case\",\n      \"quantity\": 2,\n      \"unit_price\": 14.50\n    }\n  ]\n}"},
            "url": "{{baseUrl}}/orders"
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Duplicate request returns the original order', function () {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('orderId'));",
            "});"
          ]}}]
        },
        {
          "name": "Get Created Order",
          "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/orders/{{orderId}}"},
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Created order can be retrieved', function () {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('orderId'));",
            "});"
          ]}}]
        },
        {
          "name": "List Orders - Cursor Pagination",
          "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/orders?limit=20"},
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Orders return a paginated response', function () {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().items).to.be.an('array');",
            "  pm.expect(pm.response.json()).to.have.property('next_cursor');",
            "});"
          ]}}]
        },
        {
          "name": "List Pending Orders",
          "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/orders?status=PENDING&limit=20"}
        },
        {
          "name": "Get Processed Event Audit",
          "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/orders/{{orderId}}/events"},
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('OrderCreated audit event is eventually available', function () {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json()).to.be.an('array');",
            "});"
          ]}}]
        },
        {
          "name": "Get Invoice Download URL",
          "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/orders/{{orderId}}/invoice"},
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('A private five-minute invoice URL is available', function () {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().download_url).to.include('X-Amz-');",
            "  pm.expect(pm.response.json().expires_in_seconds).to.eql(300);",
            "});"
          ]}}]
        },
        {
          "name": "Move Order to PROCESSING",
          "request": {"method": "PATCH", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"status\": \"PROCESSING\"\n}"}, "url": "{{baseUrl}}/orders/{{orderId}}/status"}
        },
        {
          "name": "Move Order to SHIPPED",
          "request": {"method": "PATCH", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"status\": \"SHIPPED\"\n}"}, "url": "{{baseUrl}}/orders/{{orderId}}/status"}
        },
        {
          "name": "Move Order to DELIVERED",
          "request": {"method": "PATCH", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"status\": \"DELIVERED\"\n}"}, "url": "{{baseUrl}}/orders/{{orderId}}/status"}
        }
      ]
    },
    {
      "name": "Orders - cancellation and validation",
      "item": [
        {
          "name": "Create PENDING Order for Cancellation",
          "event": [
            {"listen": "prerequest", "script": {"type": "text/javascript", "exec": [
              "pm.collectionVariables.set('pendingIdempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
            ]}},
            {"listen": "test", "script": {"type": "text/javascript", "exec": [
              "pm.collectionVariables.set('pendingOrderId', pm.response.json().id);"
            ]}}
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Idempotency-Key", "value": "{{pendingIdempotencyKey}}"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"customer_id\": \"customer-cancellation-001\",\n  \"items\": [\n    {\n      \"product_id\": \"SKU-CANCEL-001\",\n      \"name\": \"Cancellation Test Item\",\n      \"quantity\": 1,\n      \"unit_price\": 10.00\n    }\n  ]\n}"},
            "url": "{{baseUrl}}/orders"
          }
        },
        {
          "name": "Cancel PENDING Order",
          "request": {"method": "POST", "header": [], "url": "{{baseUrl}}/orders/{{pendingOrderId}}/cancel"},
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Only a pending order is cancelled', function () {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().status).to.eql('CANCELLED');",
            "});"
          ]}}]
        },
        {
          "name": "Reject Cancellation of Delivered Order",
          "request": {"method": "POST", "header": [], "url": "{{baseUrl}}/orders/{{orderId}}/cancel"},
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Delivered order cannot be cancelled', function () {",
            "  pm.response.to.have.status(409);",
            "  pm.expect(pm.response.json().error.code).to.eql('HTTP_409');",
            "});"
          ]}}]
        },
        {
          "name": "Reject Invalid Order",
          "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"customer_id\": \"\",\n  \"items\": []\n}"}, "url": "{{baseUrl}}/orders"},
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Invalid order is rejected', function () {",
            "  pm.response.to.have.status(422);",
            "  pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR');",
            "});"
          ]}}]
        }
      ]
    }
  ]
}
